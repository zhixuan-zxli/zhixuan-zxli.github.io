p-b.r0 { background: #2563eb; border-color: #1d4ed8; color: #ffffff; }&#xA;.post-body .cp-b.r1 { background: #dbeafe; border-color: #bfdbfe; color: #1e3a8a; }&#xA;.post-body .cp-own { margin-top: 6px; }&#xA;.post-body .cp-own .cp-mid::before { display: none; }&#xA;.post-body .cp-o { text-align: center; font-size: 11.5px; font-weight: 700; letter-spacing: .08em; line-height: 1; }&#xA;.post-body .cp-o.r0 { color: #1d4ed8; }&#xA;.post-body .cp-o.r1 { color: #1e3a8a; }&#xA;&lt;/style&gt;&#xA;&lt;!-- _class: lead --&gt;&#xA;&lt;!-- _paginate: false --&gt;&#xA;&lt;!-- _footer: &#39;&#39; --&gt;&#xA;&lt;!-- &lt;div class=&#34;kicker&#34;&gt;vLLM V1 → DEEPINFER&lt;/div&gt; --&gt;&#xA;&lt;h1 id=&#34;deepinfer-调研&#34;&gt;DeepInfer 调研&lt;/h1&gt;&#xA;&lt;h2 id=&#34;20261026&#34;&gt;2026/10/26&lt;/h2&gt;&#xA;&lt;!-- ## 保留 vLLM 的壳，换上 DeepSeek 的芯 --&gt;&#xA;&lt;hr&gt;&#xA;&lt;h2 id=&#34;deepinfer为什么做效果如何&#34;&gt;DeepInfer：为什么做，效果如何&lt;/h2&gt;&#xA;&lt;div class=&#34;cols&#34;&gt;&#xA;&lt;div&gt;&#xA;&lt;p&gt;&lt;a href=&#34;https://zhuanlan.zhihu.com/p/2095560295930508953&#34;&gt;《DeepSeek V4.1 Flash 大规模推理部署实践》&lt;/a&gt;：&lt;/p&gt;</description>
